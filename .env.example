# ─────────────────────────────────────────────────────────────────────────────
#  Lorex configuration
#
#  Copy to `.env` and fill in the two REQUIRED keys. Everything else has a
#  working default — leave it blank or delete the line.
#
#  You do NOT create databases or collections by hand. Lorex provisions the
#  database on first use and HydraDB creates collections implicitly on ingest.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# HydraDB API key. Sign up at https://app.hydradb.com and create a key.
# Hosted service — no Docker, nothing to run locally.
HYDRA_DB_API_KEY=

# Judge model for the benchmark. ONE of these — the harness auto-detects
# whichever is present and prefers the free tiers.
#   Google AI Studio (free, recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Groq (free, but a low tokens-per-minute cap makes long runs slow)
# GROQ_API_KEY=
#   Anthropic (paid — a Claude Pro subscription does NOT provide an API key)
# ANTHROPIC_API_KEY=

# ── OPTIONAL: everything below has a sensible default ───────────────────────

# Base URL for the hosted HydraDB API.
# HYDRADB_BASE_URL=https://api.hydradb.com

# Identity. LEAVE BLANK unless you have a reason not to.
#   database   = who the memory belongs to  (derived from your git email)
#   collection = which project it is        (derived from your git remote)
# Setting these only pins the names; it does not create anything, and Lorex
# creates the database for you either way.
# LOREX_DATABASE=
# LOREX_COLLECTION=

# Shared memory across agents and machines. When set, every agent naming the
# same workspace reads and writes the same memory — this is what makes the
# Claude Code -> Codex handoff work. Overrides the git-derived identity above.
# LOREX_WORKSPACE=

# Who is writing. Auto-detected (claude-code, cursor, codex, vscode); set only
# to override.
# LOREX_AGENT=

# Database used by the benchmark harness (kept separate from your real memory).
# LOREX_EVAL_DB=lorex_longmemeval

# Judge model override, e.g. gemini-2.5-flash or claude-sonnet-5.
# LOREX_EVAL_MODEL=

# Any OpenAI-compatible endpoint (OpenRouter, Together, a local Ollama).
# LOREX_LLM_BASE_URL=http://localhost:11434/v1
# LOREX_LLM_API_KEY=local

# Local write-queue cap (default 500; oldest dropped with a warning).
# LOREX_QUEUE_CAP=500

# Request timeout in ms for HydraDB calls (default 15000).
# HYDRADB_TIMEOUT_MS=15000

# Rate limits — protect your HydraDB quota from runaway agents. Defaults shown.
# Set LOREX_NO_LIMITS=1 to disable entirely (tests/benchmarks only).
# LOREX_MAX_WRITES_PER_HOUR=120
# LOREX_MAX_WRITES_PER_DAY=1000
# LOREX_MAX_QUERIES_PER_HOUR=240
# LOREX_MAX_INGEST_TOKENS_PER_DAY=2000000

# Relocate all Lorex state (config.json, queue.jsonl, usage.json, mock store).
# Default: ~/.lorex
# LOREX_HOME=

# Make recall DECLINE when two near-equally-scored values compete, instead of
# answering with the top-ranked one and flagging the dispute.
# LOREX_ABSTAIN_ON_AMBIGUITY=1
