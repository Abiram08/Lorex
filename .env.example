# ─────────────────────────────────────────────────────────────────────────────
#  Lorex configuration
#
#  Nothing is REQUIRED. Everything below has a working default — leave it
#  blank or delete the line.
#
#  You do NOT create databases or collections by hand. Lorex provisions
#  everything in local SQLite on first use.
# ─────────────────────────────────────────────────────────────────────────────

# ── OPTIONAL: everything below has a sensible default ───────────────────────

# Judge model for the benchmark. The harness auto-detects EVERY provider set
# below and FAILS OVER between them when one is rate-limited (free tiers die
# fast on a 500-question run — set at least two).
#   Google AI Studio (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Groq (free, low tokens-per-minute cap)
# GROQ_API_KEY=
#   OpenRouter (see free-tier notes in docs/BENCHMARK.md)
# LOREX_LLM_BASE_URL=https://openrouter.ai/api/v1
# LOREX_LLM_API_KEY=sk-or-...
#   Default judge model on OpenRouter is stealth/ox-alpha (free, 1M ctx).
# LOREX_EVAL_MODEL=stealth/ox-alpha
#   Anthropic (paid)
# ANTHROPIC_API_KEY=

# ── OPTIONAL: everything below has a sensible default ───────────────────────

# Identity. LEAVE BLANK unless you have a reason not to.
#   database   = who the memory belongs to  (derived from your git email)
#   collection = which project it is        (derived from your git remote)
# Setting these only pins the names; it does not create anything, and Lorex
# creates the database for you either way.
# LOREX_DATABASE=
# LOREX_COLLECTION=

# Shared memory across agents and machines. When set, every agent naming the
# same workspace reads and writes the same memory — this is what makes the
# Claude Code -> Codex handoff work. Overrides the git-derived identity above.
# LOREX_WORKSPACE=

# Who is writing. Auto-detected (claude-code, cursor, codex, vscode); set only
# to override.
# LOREX_AGENT=

# Database used by the benchmark harness (kept separate from your real memory).
# LOREX_EVAL_DB=lorex_longmemeval

# Judge model override, e.g. gemini-2.5-flash or claude-sonnet-5.
# LOREX_EVAL_MODEL=

# Any OpenAI-compatible endpoint (OpenRouter, Together, a local Ollama).
# LOREX_LLM_BASE_URL=http://localhost:11434/v1
# LOREX_LLM_API_KEY=local
#
# OpenRouter example (also used by opt-in recall synthesis):
#   LOREX_LLM_BASE_URL=https://openrouter.ai/api/v1
#   LOREX_LLM_API_KEY=sk-or-...
#   LOREX_EVAL_MODEL=google/gemini-2.5-flash        # judge for the benchmark
#   Free models end in ":free" but are rate-limited; a full 500-question run
#   checkpoints after every question, so re-run without --fresh to resume.

# Model for opt-in `recall` answer synthesis (--synthesize / synthesize:true).
# Uses the same LOREX_LLM_BASE_URL endpoint as the benchmark judge.
# LOREX_SYNTH_MODEL=gpt-4o-mini

# Rate limits — protect the local store from runaway agents. Defaults shown.
# Set LOREX_NO_LIMITS=1 to disable entirely (tests/benchmarks only).
# LOREX_MAX_WRITES_PER_HOUR=120
# LOREX_MAX_WRITES_PER_DAY=1000
# LOREX_MAX_QUERIES_PER_HOUR=240
# LOREX_MAX_INGEST_TOKENS_PER_DAY=2000000

# Relocate all Lorex state (config.json, usage.json, mock store).
# Default: ~/.lorex
# LOREX_HOME=

# Relocate just the memory store file.
# LOREX_DATA_DIR=

# Make recall DECLINE when two near-equally-scored values compete, instead of
# answering with the top-ranked one and flagging the dispute.
# LOREX_ABSTAIN_ON_AMBIGUITY=1
